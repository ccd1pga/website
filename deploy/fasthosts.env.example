# Copy this file to deploy/fasthosts.env and fill in the real values.
# Keep deploy/fasthosts.env private.

FASTHOSTS_HOST=example.fasthosts.co.uk
FASTHOSTS_USER=your-username
FASTHOSTS_PORT=22
FASTHOSTS_REMOTE_PATH=/path/to/web/root/

# This should point at the finished website output folder.
# For many static site tools this will eventually be "dist".
LOCAL_BUILD_DIR=dist
